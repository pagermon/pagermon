{
        "name": "pagermon",
        "cwd": "/home/ubuntu/workspace/server",
        "script": "app.js",
        "node_args": ["--harmony"],
        "error_file": "logs/node-app.stderr.log",
        "out_file": "logs/node-app.stdout.log",
        "pid_file": "pids/node-geo-api.pid",
        "instances": 1,
        "_instances": "//or 0 => 'max'",
        "min_uptime": "200s",
        "_min_uptime": "// 200 seconds, defaults to 1000",
        "max_restarts": 10,
        "_max_restarts": "// 10, defaults to 15",
        "max_memory_restart": "100M",
        "_max_memory_restart": "// 1 megabytes, e.g.: \"2G\", \"10M\", \"100K\", 1024 the default unit is byte.",
        "cron_restart": "1 0 * * *",
        "watch": false,
        "ignore_watch": ["[\\/\\\\]\\./", "node_modules", "config", "logs"],
        "merge_logs": true,
        "exec_interpreter": "node",
        "autorestart": true,
        "_autorestart": "// enable/disable automatic restart when an app crashes or exits",
        "vizion": false,
        "_vizion": "// enable/disable vizion features (versioning control)",
        "env": {
                "NODE_ENV": "production",
                "HOSTNAME": "",
                "USE_COOKIE_HOST": false,
                "APP_NAME": "pagermon"
        }
}
